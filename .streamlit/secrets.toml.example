# Copy this file to .streamlit/secrets.toml and fill in your real database URL.
# .streamlit/secrets.toml is gitignored — never commit real credentials.

[connections.db]
# --- Production (Supabase Postgres) ---
# Get this from Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Session pooler" connection string, port 6543, for best compatibility)
url = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres"

# --- Local testing alternative (no cloud needed) ---
# Comment out the line above and uncomment this one to use a local SQLite
# file instead while developing:
# url = "sqlite:///cashback_tracker.db"
